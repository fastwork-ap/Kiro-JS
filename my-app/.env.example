# Copy to .env (or .env.local) and set the data source for the cascading form.
#
#   mock       -> uses in-memory sample data (default; runs anywhere)
#   sharepoint -> queries the live lists on the AmazonProjectsPK site
#                 (requires a SharePoint-authenticated / connected context;
#                  the standalone dev server cannot authenticate to SharePoint)
VITE_DATA_SOURCE=mock
